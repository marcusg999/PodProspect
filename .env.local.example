# ---- PodProspect environment variables ----
# Copy to .env.local and fill in. All keys are server-side only except the
# two NEXT_PUBLIC_* Supabase values used by the browser auth client.

# Anthropic (scoring = Haiku, drafting = Sonnet)
ANTHROPIC_API_KEY=

# Podcast Index API (SHA-1 auth) — https://api.podcastindex.org
PODCAST_INDEX_KEY=
PODCAST_INDEX_SECRET=

# Firecrawl (contact-page fallback scraping) — https://firecrawl.dev
FIRECRAWL_API_KEY=

# Supabase
# SUPABASE_URL / anon key are also exposed to the browser for magic-link auth.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# NEVER expose the service role key to the client — server routes only.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: comma-separated allowlist of emails permitted to log in (single user).
ALLOWED_EMAIL=marcusgraydev@gmail.com
